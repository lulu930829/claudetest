# 开发环境配置
VITE_APP_TITLE=商城App - 开发环境

# API配置 - 开发环境使用代理
VITE_API_BASE_URL=/api
VITE_UPLOAD_URL=/api/upload
VITE_WEBSOCKET_URL=ws://localhost:8080/ws

# 第三方配置 - 使用测试环境的App ID
VITE_WECHAT_APP_ID=test_wechat_app_id
VITE_ALIPAY_APP_ID=test_alipay_app_id
VITE_QQ_APP_ID=test_qq_app_id
VITE_WEIBO_APP_ID=test_weibo_app_id

# 调试
VITE_DEBUG=true
VITE_LOG_LEVEL=debug